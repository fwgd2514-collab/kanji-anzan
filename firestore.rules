rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isLegacyProfile() {
      return request.resource.data.keys().hasOnly([
          'displayName',
          'level',
          'xp',
          'streak',
          'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 20
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 120
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && request.resource.data.xp <= 100
        && request.resource.data.streak is int
        && request.resource.data.streak >= 0
        && request.resource.data.streak <= 9999
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedAt >= 0;
    }

    function isLearnerProfile() {
      return request.resource.data.keys().hasOnly([
          'displayName',
          'streak',
          'lastStudiedAt',
          'updatedAt',
          'schemaVersion'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 20
        && request.resource.data.streak is int
        && request.resource.data.streak >= 0
        && request.resource.data.streak <= 9999
        && request.resource.data.lastStudiedAt is int
        && request.resource.data.lastStudiedAt >= 0
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedAt >= 0
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion == 4;
    }

    function isValidSkill(mode) {
      return mode in ['write', 'read', 'math', 'flash', 'memory', 'digits']
        && request.resource.data.keys().hasOnly([
          'level',
          'xp',
          'updatedAt'
        ])
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 120
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && request.resource.data.xp <= 100
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedAt >= 0;
    }

    function isDefaultGroup(groupId) {
      return groupId == 'nobiru-family-01';
    }

    function isGroupMember(groupId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/nobiru_groups/$(groupId)/members/$(request.auth.uid));
    }

    match /nobiru_groups/{groupId}/members/{memberId} {
      allow get: if request.auth != null && request.auth.uid == memberId;
      allow list, create, update, delete: if false;
    }

    match /nobiru_groups/{groupId}/learners/{learnerId} {
      allow read: if isDefaultGroup(groupId) || isGroupMember(groupId);
      allow create, update: if (isDefaultGroup(groupId) || isGroupMember(groupId))
        && (isLearnerProfile() || isLegacyProfile());
      allow delete: if false;

      match /skills/{mode} {
        allow read: if isDefaultGroup(groupId) || isGroupMember(groupId);
        allow create, update: if (isDefaultGroup(groupId) || isGroupMember(groupId))
          && isValidSkill(mode);
        allow delete: if false;
      }
    }
  }
}
